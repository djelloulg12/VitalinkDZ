# ===== بيئة رعايتي DZ — انسخ هذا الملف إلى .env وعدّل القيم =====

# ---------- الأساسيات ----------
ENVIRONMENT=production
DEBUG=false
# رابط الموقع بعد النشر (مثال: https://vitalink.onrender.com)
PUBLIC_BASE_URL=

# ---------- قاعدة البيانات ----------
# الخيار 1: Neon (مجاني، بلا بطاقة) — انسخ رابط Connection String
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/neondb?sslmode=require
# الخيار 2: Supabase (مجاني) — Project Settings > Database > URI
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# الخيار 3: SQLite محلياً (الافتراضي—nochange)
# DATABASE_URL=sqlite+aiosqlite:///./data/vitalink.db

# ---------- الأمان (مهم جداً قبل الإطلاق) ----------
# مفاتيح عشوائية طويلة — ولّدها بـ: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
SECRET_KEY=
# كلمة مرور الحسابات التجريبية
DEFAULT_PASSWORD=demo123
# فعّلها في الإطلاق الرسمي: كل مستخدم مجبر على تغيير كلمة المرور
FORCE_PASSWORD_CHANGE=false
# false في الإطلاق الرسمي (يخفي شارة العرض التجريبي)
DEMO_MODE=true

# ---------- أخرى ----------
# عند فصل الواجهة عن الخلفية فقط؛ النشر الموحّد لا يحتاجها
CORS_ORIGINS=
LLM_PROVIDER=mock
LLM_MODEL=mock
OPENAI_API_KEY=